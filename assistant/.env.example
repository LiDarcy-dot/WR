# Скопируй в .env и заполни (файл .env не коммитить)

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой числовой Telegram user id (чтобы чужие не писали боту)
# Узнать: напиши @userinfobot
TELEGRAM_OWNER_ID=

# LM Studio local server (OpenAI-compatible)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Папка данных ассистента на ПК (создай на диске / рабочем столе)
ASSISTANT_DATA_DIR=

# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow