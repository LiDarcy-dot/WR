TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Optional: forum group id (so /topics from DM still works)
TELEGRAM_GROUP_ID=
# SOCKS5/HTTP only for Telegram API (not for browser). Auto-filled from proxy.default on start.
# TELEGRAM_PROXY=socks5h://tgproxy:PASSWORD@YOUR_NL_VPS_IP:1080
# Optional MTProto (to list existing forum topics). Empty = built-in Android defaults.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
# Optional specialist models (empty = auto / same as chat):
LM_STUDIO_VISION_MODEL=
AUTO_UPDATE=1
AUTO_UPDATE_INTERVAL_SEC=120
AUTO_UPDATE_REPO=LiDarcy-dot/WR
AUTO_UPDATE_BRANCH=cursor/local-assistant-scaffold-d6ce

ASSISTANT_DATA_DIR=C:\Users\Darcy\Desktop\Assistant
TIMEZONE=Europe/Moscow
WEB_PORT=8765
